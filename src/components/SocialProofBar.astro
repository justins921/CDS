---
import { stats } from '../data/siteData';
---

<section class="border-t border-b border-navy-700/60 bg-navy-800/50">
  <div class="section-container py-10 md:py-14">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8">
      {stats.map((stat) => (
        <div class="text-center">
          <p class="text-2xl md:text-3xl font-bold gradient-text">{stat.value}</p>
          <p class="text-gray-400 text-sm mt-1">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
