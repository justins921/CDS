---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Chandler David Smith">
  <section class="min-h-screen flex items-center justify-center">
    <div class="text-center px-6">
      <p class="text-6xl md:text-8xl font-bold text-gold-400 mb-4">404</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Page Not Found</h1>
      <p class="text-gray-400 text-lg mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved. Let's get you back on track.
      </p>
      <a href="/" class="btn-primary">Back to Homepage</a>
    </div>
  </section>
</Layout>
