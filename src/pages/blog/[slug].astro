---
import Layout from '../../layouts/Layout.astro';
import { getBlogPost, getBlogPosts } from '../../lib/content.js';

const { slug } = Astro.params;
const post = getBlogPost(slug);
const allPosts = getBlogPosts();

const paragraphs = post?.content || [
  'This is a placeholder article about real estate investing. The full content for this post is coming soon.',
];

const relatedPosts = post ? allPosts.filter((p) => p.slug !== slug).slice(0, 3) : [];
---

<Layout title={post ? `${post.title} | Chandler David Smith` : 'Post Not Found | Chandler David Smith'} description={post ? post.excerpt : 'The blog post you are looking for does not exist.'}>

  {!post ? (
    <section class="min-h-screen flex items-center justify-center bg-navy-900">
      <div class="section-container text-center py-32">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Post Not Found</h1>
        <p class="text-gray-400 text-lg mb-8">
          The blog post you are looking for does not exist or has been moved.
        </p>
        <a href="/blog" class="btn-primary">
          &larr; Back to Blog
        </a>
      </div>
    </section>
  ) : (
    <section class="pt-32 pb-20 bg-navy-900">
      <div class="section-container">
        <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
          <!-- Main Content -->
          <article class="lg:col-span-2">
            <a href="/blog" class="inline-flex items-center text-gold-400 hover:text-gold-300 transition mb-8">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Back to Blog
            </a>

            <span class="inline-block px-3 py-1 bg-gold-500/15 text-gold-400 text-xs font-semibold rounded-full mb-4">
              {post.category}
            </span>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
              {post.title}
            </h1>

            <div class="flex items-center gap-4 text-gray-500 text-sm mb-10 pb-10 border-b border-navy-700">
              <span>{new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
              <span>&middot;</span>
              <span>{post.readTime}</span>
            </div>

            <div class="prose prose-invert max-w-none">
              {paragraphs.map((p) => (
                <p class="text-gray-300 text-lg leading-relaxed mb-6">
                  {p}
                </p>
              ))}
            </div>

            <!-- Inline CTA -->
            <div class="mt-12 p-8 bg-navy-800 border border-gold-500/20 rounded-xl">
              <h3 class="text-xl font-bold text-white mb-3">Want to Analyze Deals Like This?</h3>
              <p class="text-gray-400 mb-6">
                Download the free CDS Rental Property Calculator and start running the numbers on your next deal.
              </p>
              <div class="flex flex-wrap gap-4">
                <a href="/calculator" class="btn-primary">
                  Try the Calculator
                </a>
                <a href="/course" class="btn-secondary">
                  Explore the Course
                </a>
              </div>
            </div>
          </article>

          <!-- Sidebar -->
          <aside class="lg:col-span-1">
            <div class="card p-6 mb-8 sticky top-28">
              <div class="w-16 h-16 bg-navy-700 rounded-full flex items-center justify-center text-gray-500 text-xs mb-4">
                Photo
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Chandler David Smith</h3>
              <p class="text-gray-400 text-sm mb-4">
                Real estate investor with a $50M+ rental portfolio spanning 230+ doors. Helping 275K+ investors build wealth through rental properties.
              </p>
              <div class="flex gap-1">
                <a
                  href="https://youtube.com/@chandlerdavidsmith?si=EyIZoAP7oZDQOa0K"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-2 py-2 text-gray-500 hover:text-gold-400 transition text-sm"
                >
                  YouTube
                </a>
                <a
                  href="https://instagram.com/chandlerdavidsmith"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-2 py-2 text-gray-500 hover:text-gold-400 transition text-sm"
                >
                  Instagram
                </a>
                <a
                  href="https://tiktok.com/@chandlerdavidsmith"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-2 py-2 text-gray-500 hover:text-gold-400 transition text-sm"
                >
                  TikTok
                </a>
              </div>
            </div>
          </aside>
        </div>

        <!-- Related Posts -->
        <div class="mt-20 pt-16 border-t border-navy-700">
          <h2 class="section-heading mb-8">Related Posts</h2>
          <div class="grid md:grid-cols-3 gap-8">
            {relatedPosts.map((rp) => (
              <article class="card">
                <span class="inline-block px-3 py-1 bg-gold-500/15 text-gold-400 text-xs font-semibold rounded-full mb-3">
                  {rp.category}
                </span>
                <h3 class="text-lg font-bold text-white mb-2 line-clamp-2">{rp.title}</h3>
                <p class="text-gray-400 text-sm mb-4 line-clamp-2">{rp.excerpt}</p>
                <a
                  href={`/blog/${rp.slug}`}
                  class="text-gold-400 text-sm font-medium hover:text-gold-300 transition inline-flex items-center gap-1"
                >
                  Read More
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

</Layout>
