---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.jsx';
---

<Layout title="Contact | Chandler David Smith" description="Get in touch with Chandler David Smith's team. Inquiries about partnerships, media, support, and more.">

  <section class="relative pt-32 pb-20 bg-gradient-to-br from-navy-900 via-navy-800 to-navy-900 min-h-screen">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-gold-500/5 via-transparent to-transparent"></div>
    <div class="section-container relative z-10">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">
            Get In <span class="gradient-text">Touch</span>
          </h1>
          <p class="section-subheading mx-auto">
            Have a question, partnership inquiry, or media request? Fill out the form below and we will get back to you as soon as possible.
          </p>
        </div>

        <ContactForm client:load />

        <div class="text-center mt-8">
          <p class="text-gray-500">
            For support inquiries, visit our
            <a href="/support" class="text-gold-400 hover:text-gold-300 transition underline">
              Support page
            </a>.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
