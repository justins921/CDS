---
import Layout from '../../layouts/Layout.astro';
import { events } from '../../data/siteData';
import { images } from '../../data/images';

const featuredEvent = events.find((e) => e.featured);
const otherEvents = events.filter((e) => !e.featured);
const pastEventPhotos = [
  { src: images.vegasSupercar, alt: 'Vegas Retreat event photo - driving supercars' },
  { src: images.vegasCityLights, alt: 'Vegas Retreat event photo - city lights at night' },
  { src: images.vegasSign, alt: 'Vegas Retreat event photo - Las Vegas signage' },
  { src: images.vegasAttendees1, alt: 'Vegas Retreat event photo - attendees networking' },
  { src: images.vegasAttendees2, alt: 'Vegas Retreat event photo - attendee group' },
  { src: images.grandTetonFrame1, alt: 'Grand Teton Summit event photo' },
];
---

<Layout title="Real Estate Events & Retreats | Chandler David Smith">

  <!-- Hero -->
  <section class="pt-28 pb-16 bg-navy-900">
    <div class="section-container text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        Real Estate <span class="gradient-text">Events & Retreats</span>
      </h1>
      <p class="section-subheading mx-auto">
        Immersive experiences designed to accelerate your real estate investing
        journey. Connect with serious investors, tour properties, and leave with
        a clear action plan.
      </p>
    </div>
  </section>

  <!-- Featured Event -->
  {featuredEvent && (
    <section class="py-16 bg-navy-900">
      <div class="section-container">
        <div class="relative overflow-hidden rounded-2xl border border-gold-500/30 bg-gradient-to-br from-navy-800 to-navy-900 p-8 md:p-12">
          <div class="bg-gold-500 text-navy-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide inline-block mb-4">
            Featured Event
          </div>
          <div class="max-w-3xl">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
              {featuredEvent.title}
            </h2>
            <div class="flex flex-wrap gap-4 mb-6">
              <span class="flex items-center text-gold-400 text-sm font-medium">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {featuredEvent.date}
              </span>
              <span class="flex items-center text-gold-400 text-sm font-medium">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {featuredEvent.location}
              </span>
            </div>
            {featuredEvent.capacity && (
              <div class="flex flex-wrap gap-4 mb-4">
                <span class="text-gray-400 text-sm">{featuredEvent.capacity}</span>
                {featuredEvent.spotsRemaining && (
                  <span class="text-amber-400 text-sm font-semibold">{featuredEvent.spotsRemaining}</span>
                )}
              </div>
            )}
            <p class="text-gray-300 text-lg mb-4 leading-relaxed">
              {featuredEvent.description}
            </p>
            {featuredEvent.details && (
              <p class="text-gray-400 mb-8 leading-relaxed">
                {featuredEvent.details}
              </p>
            )}
            <div class="flex flex-wrap gap-4">
              <a href={`/events/${featuredEvent.slug}`} class="btn-primary">
                Apply Now
              </a>
              <a href={`/events/${featuredEvent.slug}`} class="btn-secondary">
                Learn More
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Other Events -->
  {otherEvents.length > 0 && (
    <section class="py-16 bg-navy-900">
      <div class="section-container">
        <h2 class="section-heading text-center mb-12">Upcoming Events</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {otherEvents.map((event) => (
            <div class="card flex flex-col">
              <h3 class="text-xl font-bold text-white mb-2">{event.title}</h3>
              <div class="flex flex-wrap gap-3 mb-4">
                <span class="text-gold-400 text-sm">{event.date}</span>
                <span class="text-gray-500">|</span>
                <span class="text-gray-400 text-sm">{event.location}</span>
              </div>
              <p class="text-gray-400 mb-6 flex-grow">{event.description}</p>
              <a href={`/events/${event.slug}`} class="btn-secondary text-center">
                Learn More
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Past Events Gallery -->
  <section class="py-16 bg-navy-800/50">
    <div class="section-container">
      <h2 class="section-heading text-center mb-4">Past Events</h2>
      <p class="section-subheading text-center mx-auto mb-12">
        A look back at some of our most impactful gatherings.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {pastEventPhotos.map((photo) => (
          <div class="aspect-video rounded-lg overflow-hidden">
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-16 bg-navy-900">
    <div class="section-container">
      <h2 class="section-heading text-center mb-12">What Attendees Are Saying</h2>
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="card">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 rounded-full bg-gold-500/20 flex items-center justify-center text-gold-400 font-bold mr-3">
              A
            </div>
            <div>
              <p class="text-white font-semibold">Amanda K.</p>
              <p class="text-gray-400 text-sm">Vegas Retreat Attendee</p>
            </div>
          </div>
          <p class="text-gray-300 italic">
            "The Vegas Retreat was incredible. I networked with investors doing 8-figure
            deals and left with a 12-month action plan. Already closed 3 deals since attending."
          </p>
        </div>
        <div class="card">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 rounded-full bg-gold-500/20 flex items-center justify-center text-gold-400 font-bold mr-3">
              T
            </div>
            <div>
              <p class="text-white font-semibold">Tyler B.</p>
              <p class="text-gray-400 text-sm">Grand Teton Summit Attendee</p>
            </div>
          </div>
          <p class="text-gray-300 italic">
            "Being in a room of 30 serious investors changed my perspective entirely. The
            connections I made at the Summit led to two joint venture deals within 6 months."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-navy-800/50">
    <div class="section-container max-w-3xl mx-auto">
      <h2 class="section-heading text-center mb-12">Frequently Asked Questions</h2>
      <div class="space-y-6">
        <div class="card">
          <h3 class="text-white font-semibold mb-2">What's included in the event ticket?</h3>
          <p class="text-gray-400">All event sessions, workshops, networking activities, and meals during the event are included. Accommodations and travel are not included unless otherwise specified on the event page.</p>
        </div>
        <div class="card">
          <h3 class="text-white font-semibold mb-2">Who should attend these events?</h3>
          <p class="text-gray-400">Our events are designed for both new and experienced real estate investors who are serious about scaling their portfolios. Whether you own zero doors or 100+, you will find value in the content and connections.</p>
        </div>
        <div class="card">
          <h3 class="text-white font-semibold mb-2">What is the refund policy for events?</h3>
          <p class="text-gray-400">Full refunds are available up to 30 days before the event. Between 30 and 14 days, a 50% refund is available. No refunds within 14 days of the event, but tickets are transferable.</p>
        </div>
        <div class="card">
          <h3 class="text-white font-semibold mb-2">How do I apply for the Vegas Retreat?</h3>
          <p class="text-gray-400">Click the "Apply Now" button on the Vegas Retreat card above. You will fill out a short application so we can ensure the retreat is the right fit for you. Spots are limited.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>
