---
import Layout from '../layouts/Layout.astro';
import EmailForm from '../components/EmailForm.jsx';
---

<Layout title="Free Real Estate Tools & Resources | Chandler David Smith" description="Free real estate investing tools and resources. Rental property calculator app, cashflow retirement calculator, newsletter, YouTube channel, and podcast appearances.">

  <!-- Hero -->
  <section class="relative pt-32 pb-20 bg-gradient-to-br from-navy-900 via-navy-800 to-navy-900">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-gold-500/5 via-transparent to-transparent"></div>
    <div class="section-container relative z-10 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6">
        Free Real Estate <span class="gradient-text">Tools & Resources</span>
      </h1>
      <p class="section-subheading mx-auto">
        Everything you need to start analyzing deals, building cashflow projections, and learning real estate investing — completely free.
      </p>
    </div>
  </section>

  <!-- Resource Cards -->
  <section class="py-20 bg-navy-900">
    <div class="section-container">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- CDS Rental Property Calculator -->
        <div class="card p-8">
          <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gold-500/20 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="px-3 py-1 bg-green-500/20 text-green-400 text-xs font-bold rounded-full uppercase">
              Free
            </span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">CDS Rental Property Calculator</h3>
          <p class="text-gray-400 mb-6">
            The same calculator I use to analyze every deal in my $50M+ portfolio. Analyze cash flow, cash-on-cash return, cap rate, and more in minutes. Available on iOS and Android.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://apps.apple.com"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary text-sm px-5 py-2"
            >
              App Store
            </a>
            <a
              href="https://play.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary text-sm px-5 py-2"
            >
              Google Play
            </a>
            <a href="/calculator" class="btn-ghost text-sm px-5 py-2">
              Web Version
            </a>
          </div>
        </div>

        <!-- Cashflow Retirement Calculator -->
        <div class="card p-8">
          <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gold-500/20 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="px-3 py-1 bg-green-500/20 text-green-400 text-xs font-bold rounded-full uppercase">
              Free PDF
            </span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Cashflow Retirement Calculator</h3>
          <p class="text-gray-400 mb-6">
            Figure out exactly how many rental properties you need to replace your income and retire through real estate. Download the free PDF spreadsheet.
          </p>
          <EmailForm client:visible buttonText="Download" successMessage="Check your email for the download link!" />
        </div>

        <!-- Weekly Newsletter -->
        <div class="card p-8">
          <div class="w-12 h-12 bg-gold-500/20 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Get Weekly Real Estate Insights</h3>
          <p class="text-gray-400 mb-6">
            Join 20,000+ investors receiving weekly deal breakdowns, market updates, and actionable investing tips straight to your inbox.
          </p>
          <EmailForm client:visible buttonText="Subscribe" successMessage="You're subscribed! Check your inbox." />
        </div>

        <!-- YouTube Channel -->
        <div class="card p-8">
          <div class="w-12 h-12 bg-gold-500/20 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-gold-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">YouTube Channel</h3>
          <p class="text-gray-400 mb-6">
            275K+ subscribers learning real estate investing, sales, and wealth-building strategies shared through real-world experience and deal breakdowns.
          </p>
          <a
            href="https://youtube.com/@chandlerdavidsmith?si=EyIZoAP7oZDQOa0K"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            Watch on YouTube
          </a>
        </div>
      </div>

      <!-- Podcast Appearances -->
      <div class="mt-8">
        <div class="card p-8">
          <div class="w-12 h-12 bg-gold-500/20 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Podcast Appearances</h3>
          <p class="text-gray-400 mb-6">
            Chandler has been featured on top real estate and business podcasts sharing strategies for building wealth through rental properties.
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 mt-2 bg-gold-400 rounded-full flex-shrink-0"></span>
              <div>
                <span class="text-white font-medium">BiggerPockets Podcast</span>
                <span class="text-gray-500"> — How I Built a $50M Rental Portfolio by Age 30</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 mt-2 bg-gold-400 rounded-full flex-shrink-0"></span>
              <div>
                <span class="text-white font-medium">Real Estate Rookie</span>
                <span class="text-gray-500"> — From Zero to 230+ Doors: A Step-by-Step Journey</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 mt-2 bg-gold-400 rounded-full flex-shrink-0"></span>
              <div>
                <span class="text-white font-medium">The Money Show</span>
                <span class="text-gray-500"> — Creative Financing Strategies for Rental Properties</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-2 h-2 mt-2 bg-gold-400 rounded-full flex-shrink-0"></span>
              <div>
                <span class="text-white font-medium">Invest Like a Boss</span>
                <span class="text-gray-500"> — Scaling Your Portfolio with Systems and Teams</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gradient-to-br from-navy-800 to-navy-900">
    <div class="section-container text-center">
      <h2 class="section-heading mb-4">Ready for a Deeper Dive?</h2>
      <p class="section-subheading mx-auto mb-8">
        Take your investing to the next level with our comprehensive course, private community, or one-on-one consulting.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/course" class="btn-primary text-lg px-8 py-4">
          Explore the Course
        </a>
        <a href="/community" class="btn-secondary text-lg px-8 py-4">
          Join the Community
        </a>
      </div>
    </div>
  </section>

</Layout>
